#!/usr/bin/env bash
# sycl-h3 - the command line. The real one is the static binary ./build.sh puts in dist/sycl-h3 (copy it anywhere on
# your PATH; it finds dist/ beside itself, or through H3_DIST). This only starts it from the repository.
here=$(cd "$(dirname "$0")" && pwd)
[ -x "$here/dist/sycl-h3" ] || { echo "dist/sycl-h3 is not built yet: ./setup.sh, then ./build.sh" >&2; exit 1; }
exec "$here/dist/sycl-h3" "$@"
