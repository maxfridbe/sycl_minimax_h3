#!/usr/bin/env bash
# h3-sycl - the engine as a resident service, in the podman container.
#
#   h3-sycl gpus                  the GPUs, numbered as --gpu takes them
#   h3-sycl start [--all | --gpu N ...] [--shared-gpu N ...] [--bind ADDR] [--port N]
#                                 start the daemon in the background with the web front end on its port; each GPU
#                                 (all of them by default) gets its own engine process when a job needs it, and the
#                                 model stays loaded on it between jobs
#   h3-sycl serve [same options]  the same in the foreground, its log on the terminal; Ctrl-C stops it gracefully
#   h3-sycl status [--no-stream]  the engine, live (like docker stats)
#   h3-sycl jobs ps [-a]          queued and running jobs (-a: all)
#   h3-sycl jobs add <kind> [--name value ...] [-f]
#                                 queue a job (-f: follow its log); kinds: bench-blocks (--tokens N --blocks N),
#                                 check-block (--dump /out/<file>)
#   h3-sycl jobs stop <id>... | rem <id>... | details <id>
#   h3-sycl unload                give the GPU back now (the daemon keeps running; the next job loads again)
#   h3-sycl stop                  stop: the running job stops at its next block boundary, the engine unloads
#   h3-sycl logs                  the daemon's log, followed
#
# Options win over the settings below; the other commands find the daemon wherever it was started.
# --shared-gpu N: the GPU(s) the lock file and the model switcher are about (default: every served GPU, when they are
# set) - e.g. --shared-gpu 0 when only GPU 0 also runs the front end's LLM.
#
# Settings: environment variables, or the same names in ./h3-sycl.conf or ~/.config/h3-sycl.conf
#   H3_MODELS         host directory with the checkpoints, seen as /models          (required for start)
#   H3_MODEL          the checkpoint, as seen in the container
#                     (default /models/kitchen/minimax_h3_fl2va_pruned_int8_convrot.safetensors)
#   H3_OUT            host directory for job files, seen as /out                    (default ./out)
#   H3_GPUS           the GPUs to serve, e.g. "0 1"                                 (default: all)
#   H3_SHARED_GPUS    the GPUs the lock file / model switcher are about, e.g. "0"   (default: all served)
#   H3_PORT           the daemon's port                                             (default 8095)
#   H3_LISTEN         the address it binds: 127.0.0.1 (this machine only, the default), 0.0.0.0 (every interface:
#                     the front end reachable from the network - nothing on it asks for a password) or one address
#   H3_LEGACY_API     the clip-production server the front end was written for (e.g. http://127.0.0.1:8090):
#                     front-end calls the daemon does not handle yet go there
#   H3_IDLE           seconds without a job before the engine unloads; 0 = never    (default 600)
#   H3_GPU_LOCK       a lock file shared with the GPU's other users (wait while it names someone else, hold it
#                     while loaded)
#   H3_LLM_SWITCHER   a front end's model switcher URL: its model is stopped before loading and restored after
#                     unloading (e.g. http://localhost:8090/rpc/llm.mode)
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
for f in "$HERE/h3-sycl.conf" "$HOME/.config/h3-sycl.conf"; do [ -f "$f" ] && source "$f"; done
source "$HERE/container/common.sh"
NAME=h3-sycl
MODEL=${H3_MODEL:-/models/kitchen/minimax_h3_fl2va_pruned_int8_convrot.safetensors}

running() { [ "$($CE container inspect -f '{{.State.Running}}' $NAME 2>/dev/null)" = true ]; }
# the container carries H3_DAEMON (set at start), so the client finds the daemon on whatever address it was given
client() {
  local t=(); [ -t 0 ] && [ -t 1 ] && t=(-it)        # a terminal for the live status
  $CE exec "${t[@]}" $NAME /app/h3 "$@"
}

# start / serve: the container that runs `h3 serve`; $1 = -d for the background, -i for the foreground
launch() {
  local mode=$1; shift
  local bind=${H3_LISTEN:-127.0.0.1} port=${H3_PORT:-8095}
  local gpus=(${H3_GPUS:-}) shared=(${H3_SHARED_GPUS:-}) gpus_given=0
  while [ $# -gt 0 ]; do
    case $1 in
      --bind) bind=$2; shift 2 ;;
      --port) port=$2; shift 2 ;;
      --all) gpus=(); gpus_given=1; shift ;;
      --gpu) [ $gpus_given = 0 ] && gpus=(); gpus_given=1; gpus+=("$2"); shift 2 ;;
      --shared-gpu) shared+=("$2"); shift 2 ;;
      *) echo "unknown option $1 (start/serve take --all, --gpu N, --shared-gpu N, --bind ADDR, --port N)" >&2; exit 2 ;;
    esac
  done
  [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "--port $port: not a port" >&2; exit 2; }
  if running; then echo "already running"; client status; exit 0; fi
  need_image
  [ -x "$HERE/dist/h3" ] || { echo "dist/h3 is not built yet: run ./build.sh" >&2; exit 1; }
  [ -n "${H3_MODELS:-}" ] || { echo "set H3_MODELS (the host directory with the checkpoints)" >&2; exit 1; }
  $CE rm -f $NAME >/dev/null 2>&1 || true            # a stopped one from before
  # the address the client talks to: the bound one, or the loopback interface when bound to all of them
  local reach=$bind
  case $bind in 0.0.0.0) reach=127.0.0.1 ;; ::|"[::]") reach="[::1]" ;; esac
  [[ $reach == *:* && $reach != \[* ]] && reach="[$reach]"
  OUT=${H3_OUT:-$HERE/out}; mkdir -p "$OUT"
  local mounts=(-v "$HERE/dist:/app:ro" -v "$H3_MODELS:/models:ro" -v "$OUT:/out")
  local args=(--model "$MODEL" --bind "$bind" --port "$port" --idle "${H3_IDLE:-600}" --ui /app/wfe)
  local g; for g in "${gpus[@]}"; do args+=(--gpu "$g"); done
  for g in "${shared[@]}"; do args+=(--shared-gpu "$g"); done
  [ -n "${H3_LEGACY_API:-}" ] && args+=(--legacy-api "$H3_LEGACY_API")
  if [ -n "${H3_GPU_LOCK:-}" ]; then
    local d; d=$(dirname "$H3_GPU_LOCK"); mounts+=(-v "$d:$d"); args+=(--gpu-lock "$H3_GPU_LOCK")
  fi
  [ -n "${H3_LLM_SWITCHER:-}" ] && args+=(--llm-switcher "$H3_LLM_SWITCHER")
  local tty=(); [ "$mode" = -i ] && [ -t 0 ] && tty=(-t)
  # --stop-timeout: a stop waits for the running job's next block boundary (about a second at production size)
  local run=($CE run "$mode" "${tty[@]}" --name $NAME --network host --stop-timeout 150 "${AS_USER[@]}" "${GPU[@]}" "${mounts[@]}"
             -e H3SYCL_LIB=/app/libh3sycl.so -e "H3_DAEMON=$reach:$port" -e "ONEAPI_DEVICE_SELECTOR=level_zero:*" ${H3S_MEM_FRACTION:+-e H3S_MEM_FRACTION=$H3S_MEM_FRACTION}
             "$IMAGE" bash -c 'source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1; exec /app/h3 serve "$@"' h3 "${args[@]}")
  local shown=$reach; [ "$bind" = 0.0.0.0 ] && shown=$(hostname)
  if [ "$mode" = -i ]; then
    echo "front end: http://$shown:$port/   (Ctrl-C stops it)"
    "${run[@]}"
    $CE rm $NAME >/dev/null 2>&1 || true
  else
    "${run[@]}" >/dev/null
    for _ in $(seq 1 50); do client status >/dev/null 2>&1 && break; sleep 0.2; done
    client status
    echo "front end: http://$shown:$port/"
  fi
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  gpus)
    need_image
    [ -x "$HERE/dist/h3" ] || { echo "dist/h3 is not built yet: run ./build.sh" >&2; exit 1; }
    $CE run --rm "${AS_USER[@]}" "${GPU[@]}" -v "$HERE/dist:/app:ro" -e H3SYCL_LIB=/app/libh3sycl.so \
      -e "ONEAPI_DEVICE_SELECTOR=level_zero:*" "$IMAGE" \
      bash -c 'source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1; exec /app/h3 gpus "$@"' h3 "$@"
    ;;
  start) launch -d "$@" ;;
  serve) launch -i "$@" ;;
  stop)
    if ! running; then echo "not running"; exit 0; fi
    client shutdown >/dev/null 2>&1 || true
    # the daemon exits by itself once the engine has unloaded; podman stop is the backstop (SIGTERM, then 150 s)
    for _ in $(seq 1 150); do running || break; sleep 1; done
    running && $CE stop -t 150 $NAME >/dev/null
    $CE rm $NAME >/dev/null 2>&1 || true
    echo "stopped"
    ;;
  status|jobs|unload)
    running || { echo "not running: h3-sycl start" >&2; exit 1; }
    client "$cmd" "$@"
    ;;
  logs)
    exec $CE logs -f $NAME
    ;;
  *)
    sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
